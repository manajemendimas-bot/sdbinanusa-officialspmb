# Supabase (buat project di https://supabase.com → Project Settings → API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
# Opsional: kalau pakai Supabase CLI / anon key untuk hal lain
# SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Admin session (shared password, dicek di server — tidak bocor ke bundle)
ADMIN_ALLOWED_EMAILS="admin@binanusa.sch.id,admin@arrafah.sch.id,panitia@binanusa.sch.id"
ADMIN_PASSWORD="ganti-di-.env.local-jangan-commit"
ADMIN_SESSION_SECRET="ganti-di-.env.local-openssl-rand-hex-32"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
